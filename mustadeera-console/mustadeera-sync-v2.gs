/**
 * المستديرة — حارس الشيت  (النسخة ٢ — نموذج العمولة المتدرّجة، 2026-08-31)
 * ══════════════════════════════════════════════════════════════════════
 * يعالج ثلاث مشاكل مقيسة، كلٌّ منها يقع فعلًا وأنت تعدّل من الهاتف:
 *
 *  ①  تطبيق Google Sheets على الجوّال **يمسح تنسيق الخليّة** عند الكتابة،
 *      فتصير «١٠٪» رقمًا عاريًا. السكربت يعيد التنسيق بعد كلّ تعديل.
 *  ②  تكتب «10» في خانة نسبة ⇒ تصير ١٠٪ لا ١٠٠٠٪.
 *  ③  الخانات الخضراء في الحاسبتين **روابط** إلى «الثوابت». لو كتبتَ فوق
 *      واحدةٍ منها رقمًا، ذهب الرابط بصمت وتباعدت الأوراق. الآن:
 *      يُدفَع رقمُك إلى «الثوابت» **ويُعاد الرابط مكانه** ⇒ تعدّل من أيّ
 *      ورقةٍ شئت، ومصدر الحقيقة يبقى واحدًا.
 *
 * ⚠️  لا يجوز وجود دالّة onEdit ثانية في المشروع — واحدةٌ فقط تعمل ولا
 *     يُقال أيّها. إن كانت عندك النسخة القديمة فاحذفها قبل لصق هذه.
 * ⚠️  قوائم Apps Script لا تظهر في تطبيق الجوّال — بنود القائمة تُشغَّل من
 *     الكمبيوتر، أمّا الحراسة التلقائية في onEdit فتعمل في الجهتين.
 *
 * التركيب: الشيت ← الإضافات ← Apps Script ← الصق هذا الملفّ ← احفظ.
 *          ثمّ من قائمة «المستديرة» في أعلى الشيت: «افحص الحالة».
 */

var CON  = 'الثوابت';
var CALC = 'حاسبة الملعب';
var ECON = 'اقتصاديات المنصة';

/**
 * خريطة الخانات التي يديرها السكربت — **المصدر الوحيد** لكلّ دوالّه.
 *   f : التنسيق الصحيح (يُعاد بعد كلّ كتابة)
 *   p : خانة نسبة  ⇒ «10» تُقرأ ١٠٪
 *   L : رقم صفّها في «الثوابت»  ⇒ خانة **مرتبطة** لا خانة إدخال
 */
var SPEC = {};

SPEC[CON] = {
  'B5':  { f: '@'        },                 // نموذج التسعير
  'B6':  { f: '0.0%', p: true },            // نسبة الشريحة الأولى
  'B7':  { f: '#,##0'    },                 // عدد حجوزات الشريحة الأولى
  'B8':  { f: '0.0%', p: true },            // نسبة ما بعدها
  'B9':  { f: '#,##0'    },                 // السقف لكل ملعب فرعي
  'B10': { f: '#,##0'    },                 // أشهر مجّانية
  'B11': { f: '#,##0'    },                 // الاشتراك (للمقارنة)
  'B12': { f: '@'        },                 // كيف تُحصَّل العمولة
  'B15': { f: '#,##0.00' },                 // سعر الحجزة المرجعي
  'B16': { f: '#,##0'    },                 // جرّب: عدد حجوزات الشهر
  'B23': { f: '#,##0'    },                 // مهلة إلغاء اللاعب
  'B24': { f: '#,##0'    },                 // مهلة ردّ صاحب الملعب
  'B25': { f: '@' }, 'B26': { f: '@' }, 'B27': { f: '@' }, 'B28': { f: '@' },
  'B31': { f: '@' }, 'B32': { f: '@' }
};

SPEC[CALC] = {
  'B11': { f: '0.0'      },                 // حجوزاته الشهرية
  'B12': { f: '#,##0'    },                 // عدد ملاعبه الفرعية
  'B13': { f: '#,##0.00' },                 // متوسط سعر الحجزة
  'B14': { f: '#,##0.00' },                 // تكلفته المتغيّرة
  'B15': { f: '0%',   p: true },            // ٪ ما يمرّ عبر المنصّة
  'B16': { f: '#,##0'    },                 // حجوزات جديدة
  'B19': { f: 'General',        L: 5  },
  'B20': { f: '0.0%', p: true,  L: 6  },
  'B21': { f: '#,##0',          L: 7  },
  'B22': { f: '0.0%', p: true,  L: 8  },
  'B23': { f: '#,##0',          L: 9  },
  'B24': { f: '#,##0',          L: 10 },
  'B25': { f: '#,##0',          L: 11 }
};

SPEC[ECON] = {
  'B23': { f: 'General',        L: 5  },
  'B24': { f: '0.0%', p: true,  L: 6  },
  'B25': { f: '#,##0',          L: 7  },
  'B26': { f: '0.0%', p: true,  L: 8  },
  'B27': { f: '#,##0',          L: 9  },
  'B28': { f: '#,##0',          L: 10 },
  'B29': { f: '#,##0',          L: 11 },
  'B32': { f: '0.000'    },                 // تكلفة رسالة التحقّق
  'B33': { f: '#,##0.0'  },                 // رسائل لكل حجزة
  'B34': { f: '#,##0'    },                 // بنية تحتية
  'B35': { f: '#,##0'    },                 // تكاليف ثابتة أخرى
  'B36': { f: '0%',   p: true },            // تسرّب الأماكن
  'B37': { f: '#,##0'    }                  // أماكن جديدة شهريًّا
};

// أعمدة الرياضات الأربعة في «اقتصاديات المنصة» — تُولَّد ولا تُكتب أربع مرّات
['B', 'C', 'D', 'E'].forEach(function (c) {
  SPEC[ECON][c + '11'] = { f: '#,##0'   };  // عدد الأماكن
  SPEC[ECON][c + '12'] = { f: '#,##0.0' };  // متوسط الملاعب الفرعية
  SPEC[ECON][c + '13'] = { f: '#,##0.0' };  // الحجوزات الأسبوعية لكل ملعب فرعي
  SPEC[ECON][c + '14'] = { f: '#,##0'   };  // متوسط سعر الحجزة
});


// ══════════════════════════════════════════════════════════
//  الحراسة الحيّة  —  وهذه وحدها تعمل من الجوّال
// ══════════════════════════════════════════════════════════
function onEdit(e) {
  if (!e || !e.range) return;
  if (e.range.getNumRows() > 1 || e.range.getNumColumns() > 1) return;  // لصقُ نطاق — تجاهَل

  var ss    = e.source;
  var sheet = e.range.getSheet().getName();
  var a1    = e.range.getA1Notation();
  var spec  = SPEC[sheet] && SPEC[sheet][a1];
  if (!spec) return;

  var val = e.range.getValue();

  // ①  نسبة كُتبت رقمًا عاريًا: «10» ⇒ ١٠٪
  //     محصَّنٌ ضدّ الاحتمالين معًا: إن مسح الجوّالُ التنسيق خُزِّن 10 فيُقسَم،
  //     وإن أبقاه خُزِّن 0.1 فلا يُلمَس. الملتبس الوحيد «1» ⇒ ١٠٠٪.
  if (spec.p && typeof val === 'number' && val > 1) {
    val = Math.round(val / 100 * 10000) / 10000;
    e.range.setValue(val);
    ss.toast('قرأتُها ' + (Math.round(val * 10000) / 100) + '٪ — اكتب الرقم عاريًا وأنا أضبطه',
             '✅ نسبة', 5);
  }

  // ②  خانة مرتبطة كُتب فوقها: ادفع الرقم إلى «الثوابت» ثمّ أعِد الرابط
  if (spec.L) {
    var f = e.range.getFormula();
    if (!f || f.charAt(0) !== '=') {                 // كُتبت قيمةٌ لا صيغة
      var src = ss.getSheetByName(CON);
      if (src) {
        src.getRange('B' + spec.L).setValue(val);
        var sSpec = SPEC[CON]['B' + spec.L];
        if (sSpec) src.getRange('B' + spec.L).setNumberFormat(sSpec.f);
        ss.toast('نقلتُها إلى «الثوابت» — وهي الآن في كلّ الأوراق', '🔗 مصدر واحد', 5);
      }
    }
    e.range.setFormula("='" + CON + "'!$B$" + spec.L);   // الرابط يعود دائمًا
  }

  // ③  التنسيق يُعاد — لأنّ تطبيق الجوّال يمسحه عند الكتابة
  if (e.range.getNumberFormat() !== spec.f) e.range.setNumberFormat(spec.f);
}


// ══════════════════════════════════════════════════════════
//  أدوات القائمة  (من الكمبيوتر — لا تظهر في تطبيق الجوّال)
// ══════════════════════════════════════════════════════════
function onOpen() {
  SpreadsheetApp.getUi().createMenu('المستديرة')
    .addItem('افحص الحالة', 'checkState')
    .addSeparator()
    .addItem('أصلح التنسيقات', 'fixFormats')
    .addItem('أصلح الروابط', 'repairLinks')
    .addToUi();
}

/** يعيد التنسيق الصحيح إلى كلّ خانةٍ يديرها السكربت. */
function fixFormats() {
  var ss = SpreadsheetApp.getActive(), n = 0, missing = [];
  eachSpec_(ss, function (sh, a1, spec) { sh.getRange(a1).setNumberFormat(spec.f); n++; },
            function (name) { missing.push(name); });
  ss.toast('أُعيد تنسيق ' + n + ' خانة' +
           (missing.length ? '  ·  أوراق مفقودة: ' + missing.join('، ') : ''), '✅ التنسيقات', 6);
}

/** يعيد كتابة كلّ رابطٍ إلى «الثوابت» — لمن كتب فوق خانةٍ خضراء والسكربت متوقّف. */
function repairLinks() {
  var ss = SpreadsheetApp.getActive(), n = 0;
  eachSpec_(ss, function (sh, a1, spec) {
    if (!spec.L) return;
    sh.getRange(a1).setFormula("='" + CON + "'!$B$" + spec.L).setNumberFormat(spec.f);
    n++;
  });
  ss.toast('أُعيد ' + n + ' رابطًا إلى «الثوابت»', '🔗 الروابط', 6);
}

/** تقريرٌ واحد: القيمة · التنسيق · وهل الرابط سليم. */
function checkState() {
  var ss = SpreadsheetApp.getActive();
  var out = [], badFmt = 0, brokenLink = 0, missing = 0;

  eachSpec_(ss, function (sh, a1, spec) {
    var rg  = sh.getRange(a1);
    var fmt = rg.getNumberFormat();
    var lbl = sh.getRange(rg.getRow(), 1).getDisplayValue();
    var okF = (fmt === spec.f);
    var f   = rg.getFormula();
    var okL = !spec.L || (f.indexOf(CON) > -1 && f.indexOf('$B$' + spec.L) > -1);
    if (!okF) badFmt++;
    if (!okL) brokenLink++;
    out.push((okF && okL ? '✅ ' : '🔧 ') + sh.getName() + '!' + a1 + '  ←  «' + lbl + '»' +
             '\n      القيمة: ' + rg.getDisplayValue() +
             (spec.L ? (okL ? '   (مرتبطة بـ الثوابت!B' + spec.L + ')'
                            : '   ⛔ الرابط مكسور — شغّل «أصلح الروابط»') : '') +
             (okF ? '' : '\n      التنسيق: ' + fmt + '  ⟵  المفروض ' + spec.f));
  }, function (name) { missing++; out.push('❌ ورقة غير موجودة: ' + name); });

  out.push('');
  out.push('تنسيق خاطئ: ' + badFmt + '   ·   رابط مكسور: ' + brokenLink +
           '   ·   أوراق مفقودة: ' + missing);
  if (badFmt)     out.push('شغّل «أصلح التنسيقات».');
  if (brokenLink) out.push('شغّل «أصلح الروابط» — ثمّ تأكّد أنّ الرقم في «الثوابت» هو الذي تريده.');
  if (!badFmt && !brokenLink && !missing) out.push('كلّ شيء في مكانه.');
  out.push('');
  out.push('اقرأ التسمية بجانب كلّ عنوان وتأكّد أنّها الرقم الذي تقصده.');
  out.push('لا مطابقة آليّة للتسميات هنا عمدًا: صياغتها تختلف بين الأوراق');
  out.push('(«حجوزاته الشهرية» مقابل «متوسط الحجوزات») فتُخرج تنبيهًا كاذبًا،');
  out.push('وحارسٌ يصرخ بلا سبب حارسٌ يُعطَّل.');

  SpreadsheetApp.getUi().alert('حالة الشيت', out.join('\n'), SpreadsheetApp.getUi().ButtonSet.OK);
}


// ══════════════════════════════════════════════════════════
//  مساعد واحد يمرّ على الخريطة  —  فلا تنحرف الدوالّ الثلاث عنها
// ══════════════════════════════════════════════════════════
function eachSpec_(ss, fn, onMissing) {
  Object.keys(SPEC).forEach(function (name) {
    var sh = ss.getSheetByName(name);
    if (!sh) { if (onMissing) onMissing(name); return; }
    Object.keys(SPEC[name]).forEach(function (a1) { fn(sh, a1, SPEC[name][a1]); });
  });
}
