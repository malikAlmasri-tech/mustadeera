# Cloudflare Pages headers. This file replaces vercel.json - Cloudflare
# does not read that. Copied verbatim into public/ by build-site.ps1.
# Syntax: a path pattern, then indented "Header: value" lines.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# 'unsafe-inline' is required, not sloppiness: the site inlines its whole
# stylesheet and one small theme script, and /app is a single-file SPA with
# its JS inline. connect-src lists the two backends the SPA talks to -
# Apps Script today, Supabase after stage (D) of PLAN-2-website.md.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://*.supabase.co https://script.google.com https://script.googleusercontent.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'

# NOT immutable, and not a year: these filenames carry no content hash, so a
# year-long immutable cache would pin a stale logo on returning visitors with
# no way to bust it. A week plus stale-while-revalidate gets nearly the same
# hit rate and still corrects itself. Switch to immutable only if the build
# starts fingerprinting asset filenames.
/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

# The APK must arrive as a download, not as something the browser tries to
# render. Both headers are required - Content-Type alone is not enough on
# some Android browsers. (Stage C of PLAN-2-website.md.)
/*.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment

/sitemap.xml
  Cache-Control: public, max-age=3600
